<?xml version="1.0" encoding="utf-8"?>

<!-- Main layout for the pantry list screen. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".PantryListActivity">

    <!-- Heading displayed at the top of the pantry screen -->
    <TextView
        android:id="@+id/pantryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button for adding new ingredients to the pantry -->
    <Button
        android:id="@+id/addButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Add Ingredient"
        app:layout_constraintTop_toBottomOf="@+id/pantryTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Displays the pantry ingredients given by the adapter -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pantryRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/pantryTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/pantry_item" />

</androidx.constraintlayout.widget.ConstraintLayout>